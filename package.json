{
	"name": "github-action-release-changelog",
	"version": "2.0.10",
	"private": true,
	"description": "GitHub Action for generating a changelog of all the git commits between the new tag and the latest tags.",
	"keywords": [
		"github-action",
		"action",
		"changelog"
	],
	"homepage": "https://github.com/kitschpatrol/github-action-release-changelog",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/github-action-release-changelog.git"
	},
	"license": "MIT",
	"author": {
		"name": "Javier Bullrich",
		"email": "javier@bullrich.dev",
		"url": "https://bullrich.dev"
	},
	"contributors": [
		{
			"name": "Eric Mika",
			"email": "eric@ericmika.com",
			"url": "https://ericmika.com"
		}
	],
	"type": "module",
	"scripts": {
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc-mdat fix && ksc-prettier fix",
		"lint": "ksc-mdat lint && ksc-prettier lint",
		"release": "bumpp --commit 'Release: %s' && ./scripts/sync-major-tag.sh"
	},
	"devDependencies": {
		"@kitschpatrol/mdat-config": "^8.13.1",
		"@kitschpatrol/prettier-config": "^8.13.1",
		"bumpp": "^12.3.0"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	}
}
